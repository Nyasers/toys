{
  "name": "toys",
  "version": "1.0.0",
  "private": true,
  "description": "Nyasers 的小玩具：一个仓库，多个单页，按 path 挂在同一个站点上",
  "type": "module",
  "license": "MPL-2.0",
  "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:minify": "pnpm -r build:minify",
    "build:standalone": "pnpm -r build:standalone",
    "build:standalone:minify": "pnpm -r build:standalone:minify",
    "preview": "pnpm -r --parallel preview",
    "site": "pnpm build:standalone:minify && node scripts/assemble-site.mjs"
  }
}
